ZENDESK_SUBDOMAIN=suaempresa
ZENDESK_OAUTH_CLIENT_ID=<Identifier do OAuth Client, gerado no Admin Center>
ZENDESK_OAUTH_CLIENT_SECRET=<Secret do OAuth Client, exibido uma única vez>
# Opcional; "read write" (padrão) equivale ao acesso total que o token de API tinha.
# ZENDESK_OAUTH_SCOPE=read write

# JSON com um token por cliente: {"nome-do-cliente": "token"}. Gere cada token com
# scripts/generate_token.py e revogue individualmente removendo a entrada correspondente.
MCP_SERVER_API_KEYS={"claude-desktop": "TOKEN-DE-ACESSO-VAI-AQUI"}

# Opcionais
# Segundos de cache local para leituras (list_tickets, get_ticket, search_tickets, get_user,
# list_organizations, list_groups, search_guides, get_guide, list_guide_categories); 0 desativa
# o cache. Qualquer escrita (create/update/comment) limpa o cache todo.
CACHE_TTL_SECONDS=30
# Signing secret do webhook do Zendesk (Admin Center > Apps and integrations > Webhooks).
# Se definido, o servidor expõe POST /webhooks/zendesk (sem exigir o bearer token do MCP,
# autenticado pela assinatura HMAC do próprio Zendesk) e limpa o cache a cada evento recebido.
# Deixe vazio/ausente para não expor o endpoint de webhook.
ZENDESK_WEBHOOK_SECRET=

# Rate limit com backoff exponencial para tentativas de autenticação incorretas no MCP
# (por IP de origem). Após esse número de falhas seguidas, cada nova tentativa incorreta
# aumenta o tempo de bloqueio (dobra a cada tentativa, teto de 5 min); uma autenticação
# correta zera o contador daquele IP.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_BASE_SECONDS=1

# Opcional: limite de volume de chamadas autenticadas por client_id (diferente do rate
# limit acima, que só conta tentativas de autenticação incorretas por IP). Protege o rate
# limit do Zendesk — compartilhado pelas mesmas credenciais OAuth entre todos os clientes —
# de ser esgotado por um único cliente com bug (ex.: preso num loop de retry). Vazio/ausente
# desativa (padrão).
CLIENT_RATE_LIMIT_MAX_REQUESTS=
CLIENT_RATE_LIMIT_WINDOW_SECONDS=60
